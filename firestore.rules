rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Verificación básica de sesión activa
    function isAuthenticated() {
      return request.auth != null;
    }

    // 2. Reconocimiento inmutable de la raíz del sistema
    function isSuperadmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'webmaster@iiresodh.org' ||
        request.auth.token.email == 'durquilla@iiresodh.org'
      );
    }

    // 3. BLINDAJE CORPORATIVO: Comprueba si el email pertenece al dominio institucional o está en usuarios_autorizados
    function isAuthorized() {
      return isSuperadmin() || (
        isAuthenticated() && (
          request.auth.token.email.matches('.*@(iiresodh\\.org|sipdh\\.com)$') ||
          exists(/databases/$(database)/documents/usuarios_autorizados/$(request.auth.token.email))
        )
      );
    }

    // 4. EXTRACCIÓN TRANSACCIONAL: Obtiene el rol directamente del servidor de Google sin confiar en el cliente
    function getRole() {
      return exists(/databases/$(database)/documents/usuarios_autorizados/$(request.auth.token.email))
        ? get(/databases/$(database)/documents/usuarios_autorizados/$(request.auth.token.email)).data.rol
        : 'Admin';
    }

    // 5. Jerarquía de privilegios administrativos
    function isAdmin() {
      return isSuperadmin() || (isAuthorized() && (getRole() == 'Admin' || getRole() == 'Superadmin'));
    }

    // =================================================================
    // SEGURIDAD: LOGS DE AUDITORÍA
    // =================================================================
    match /logs_auditoria/{logId} {
      allow create: if isAuthenticated();
      allow read, delete: if isSuperadmin();
      allow update: if false; // Inmutabilidad total
    }

    // =================================================================
    // SEGURIDAD: LISTA BLANCA DE USUARIOS (ID del doc es el EMAIL)
    // =================================================================
    match /usuarios_autorizados/{emailId} {
      allow read: if isAuthenticated();
      
      // El Superadmin puede todo. Los Admins pueden autorizar siempre y cuando no intenten escalar roles a Admin o Superadmin
      allow create, update: if isSuperadmin() || (
        isAdmin() && 
        request.resource.data.rol != 'Admin' && 
        request.resource.data.rol != 'Superadmin'
      );
      
      allow delete: if isSuperadmin() || isAdmin();
    }

    // =================================================================
    // SEGURIDAD: CENTRO DE RECURSOS INSTITUCIONALES
    // =================================================================
    match /recursos_institucionales/{recursoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }


    // =================================================================
    // SEGURIDAD: PLANTILLAS DE CORREO MASIVO
    // =================================================================
    match /plantillas_correo/{templateId} {
      allow read, write: if isAuthorized();
    }

    // =================================================================
    // SEGURIDAD: EXPEDIENTES JURÍDICOS Y LITIGIOS
    // =================================================================
    match /casos/{casoId} {
      allow read, create, update: if isAuthorized();
      allow delete: if isAdmin();

      match /clientes/{clienteId} {
        allow read, write: if isAuthorized();
        
        match /notas/{notaId} { allow read, write: if isAuthorized(); }
        match /documentos/{docId} { allow read, write: if isAuthorized(); }
        match /historial_comunicados/{comunicadoId} { allow read, write: if isAuthorized(); }
      }
      
      match /documentos_comunes/{docId} {
        allow read, write: if isAuthorized();
      }

      match /comunicados/{comunicadoId} {
        allow read, write: if isAuthorized();
      }
    }

    // =================================================================
    // SEGURIDAD: MENSAJERÍA WHATSAPP BUSINESS API (MULTI-USUARIO)
    // =================================================================
    match /whatsapp_chats/{chatId} {
      allow read, create, update: if isAuthorized();
      allow delete: if isAdmin();

      match /mensajes/{mensajeId} {
        allow read, create, update: if isAuthorized();
        allow delete: if isAdmin();
      }
    }

    // Configuración institucional de credenciales y estado de recepción de llamadas de Meta API
    match /whatsapp_config/{docId} {
      allow read, write: if isAuthorized();
    }

    // Registro en tiempo real de llamadas de voz entrantes/salientes de WhatsApp (WebRTC)
    match /whatsapp_calls/{callId} {
      allow read, write: if isAuthorized();
    }

    // Tokens de Notificaciones Push PWA (Android e iOS) para WhatsApp y Workspace
    match /pwa_fcm_tokens/{tokenId} {
      allow read, create, update, delete: if isAuthorized();
    }

    // =================================================================
    // SEGURIDAD: ESPACIO DE TRABAJO COLABORATIVO (SLACK + CALENDARIO HÍBRIDO)
    // =================================================================
    match /workspace_canales/{canalId} {
      allow read, create, update: if isAuthorized();
      allow delete: if isAdmin() || (isAuthorized() && resource.data.esPrivado == true && resource.data.creadoPor == request.auth.token.email);

      match /mensajes/{mensajeId} {
        allow read, create, update, delete: if isAuthorized();
      }
    }

    match /workspace_presencia/{userEmail} {
      allow read, write: if isAuthorized();
    }

    match /workspace_eventos/{eventoId} {
      allow read, create, update, delete: if isAuthorized();
    }

    match /workspace_proyectos/{proyectoId} {
      allow read, create, update, delete: if isAuthorized();
    }

    match /workspace_tareas/{tareaId} {
      allow read, create, update, delete: if isAuthorized();
    }

    match /workspace_drive/{itemId} {
      allow read, create, update, delete: if isAuthorized();
    }

    match /workspace_guardados/{guardadoId} {
      allow read, create, update, delete: if isAuthorized();
    }

    match /workspace_canvas/{canalId} {
      allow read, create, update, delete: if isAuthorized();
    }
    
  }
}

